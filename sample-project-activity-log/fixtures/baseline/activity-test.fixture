// test/activity.test.js
// Day1-S2: AC ↔ 테스트 이름 매핑을 읽어 보세요.
// Day2-S4: 아래 { skip: true } 두 곳을 제거하고 src/activity.js 의 sessionize 를 구현하세요(test-first).
import { test } from 'node:test';
import assert from 'node:assert/strict';
import {
  isValidEvent, durationByApp, categorize, topApps, collectEvents, sessionize,
} from '../src/activity.js';

const T = (h, m = 0) => Date.parse(`2026-07-05T${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:00Z`);
const MIN = 60 * 1000;

const events = [
  { app: 'vscode', start: T(9, 0),  end: T(9, 30) },  // 30m
  { app: 'chrome', start: T(9, 35), end: T(9, 50) },  // 15m (직전과 5분 간격)
  { app: 'vscode', start: T(11, 0), end: T(11, 20) }, // 20m (직전과 70분 간격=유휴)
  { app: 'slack',  start: T(9, 50), end: T(9, 50) },  // 무효(start==end)
];

// --- 집계·분류·요약·수집(정상·경계·예외): baseline green ---
test('isValidEvent: app 문자열 + start<end', () => {
  assert.equal(isValidEvent({ app: 'x', start: T(9), end: T(10) }), true);
  assert.equal(isValidEvent({ app: 'x', start: T(10), end: T(9) }), false); // 역순
  assert.equal(isValidEvent({ start: T(9), end: T(10) }), false);           // app 없음
});

test('durationByApp: 앱별 사용시간 합(무효 이벤트는 제외)', () => {
  const d = durationByApp(events);
  assert.equal(d.vscode, 50 * MIN); // 30 + 20
  assert.equal(d.chrome, 15 * MIN);
  assert.equal(d.slack, undefined); // 무효 → 집계 안 됨
});

test('categorize: 규칙에 없으면 other', () => {
  const rules = { vscode: 'work', slack: 'comm' };
  assert.equal(categorize('vscode', rules), 'work');
  assert.equal(categorize('unknown', rules), 'other');
});

test('topApps: 사용시간 내림차순 상위 N', () => {
  const t = topApps(durationByApp(events), 1);
  assert.equal(t.length, 1);
  assert.equal(t[0].app, 'vscode'); // 50m 최상위
  assert.deepEqual(topApps(durationByApp(events), 0), []); // 경계 N<=0
});

test('collectEvents: collector 미주입/실패 → 빈 배열, 성공 → 그대로', async () => {
  const fake = async () => [{ app: 'x', start: T(9), end: T(10) }];
  const boom = async () => { throw new Error('io'); };
  assert.deepEqual(await collectEvents('today', {}), []);                     // 미주입
  assert.equal((await collectEvents('today', { collector: fake })).length, 1);
  assert.deepEqual(await collectEvents('today', { collector: boom }), []);    // 실패 → 안전
});

// --- Day2-S4 SDD test-first (sessionize 구현 전이라 skip) ---
test('sessionize: 유휴 간격(>gap) 기준으로 집중 세션 분리', { skip: true }, () => {
  // 5분 유휴 기준: 9:00~9:50(간격 5분≤5분 → 이어짐) 한 세션 + 11:00~11:20 별도 = 2세션
  const s = sessionize(events, 5 * MIN);
  assert.equal(s.length, 2);
  assert.equal(s[0].count, 2); // vscode + chrome 이 한 집중 블록
});

test('sessionize: 간격이 정확히 gap이면 같은 세션(경계 ≤)', { skip: true }, () => {
  const a = [
    { app: 'x', start: T(9, 0), end: T(9, 10) },
    { app: 'y', start: T(9, 15), end: T(9, 20) }, // 간격 5분 == idleGap → 같은 세션
  ];
  assert.equal(sessionize(a, 5 * MIN).length, 1);
});