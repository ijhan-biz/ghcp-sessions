{
  "name": "sample-project-activity-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "전원 공통 self-paced 실습 — 비식별 활동 이벤트의 집계·집중 세션화를 순수 로직으로 검증하는 Node 18+ 프로젝트.",
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test",
    "lab": "node scripts/lab-runner.mjs",
    "lab:selftest": "node --test scripts/lab-runner.selftest.mjs",
    "lab:dry-run": "node scripts/self-paced-dry-run.mjs",
    "spec-check": "node scripts/spec-check.mjs",
    "token-estimate": "node scripts/token-estimate.mjs",
    "env": "node scripts/check-env.mjs",
    "lint": "node scripts/lint.mjs",
    "policy-check": "node --test scripts/policy-check.selftest.mjs && node scripts/policy-check.mjs",
    "gate": "npm run lint && npm test && npm run lab:selftest && npm run policy-check",
    "sim": "node scripts/long-running-sim.mjs",
    "packet": "node scripts/make-review-packet.mjs",
    "routing": "node scripts/model-routing-demo.mjs"
  }
}
